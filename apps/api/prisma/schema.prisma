generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum OrganizationJoinPolicy {
  OPEN
  APPROVAL_REQUIRED
}

enum OrganizationRole {
  ADMIN
  MEMBER
}

enum OrganizationMembershipStatus {
  PENDING
  ACTIVE
}

enum DocumentProcessingStatus {
  READY
  QUEUED
  PROCESSING
  AWAITING_RAG
  FAILED
}

model User {
  user_id       String                   @id @default(uuid()) @db.Uuid
  role          Role                     @default(USER)
  refreshToken  String?                  @db.Char(64)
  email         String                   @unique @db.VarChar(254)
  password_hash String
  created_at    DateTime                 @default(now()) @db.Timestamptz(6)
  memberships   OrganizationMembership[]
  documents     Document[]

  @@map("auth_users")
}

model Organization {
  organization_id String                   @id @default(uuid()) @db.Uuid
  name            String                   @db.VarChar(100)
  join_policy     OrganizationJoinPolicy
  invite_code     String                   @unique @db.Char(32)
  created_at      DateTime                 @default(now()) @db.Timestamptz(6)
  memberships     OrganizationMembership[]
  documents       Document[]

  @@map("auth_organizations")
}

model OrganizationMembership {
  organization_id String                       @db.Uuid
  user_id         String                       @db.Uuid
  role            OrganizationRole             @default(MEMBER)
  status          OrganizationMembershipStatus
  created_at      DateTime                     @default(now()) @db.Timestamptz(6)
  organization    Organization                 @relation(fields: [organization_id], references: [organization_id], onDelete: Cascade)
  user            User                         @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@id([organization_id, user_id])
  @@index([user_id])
  @@map("auth_organization_memberships")
}

model Document {
  document_id     String                   @id @db.Uuid
  organization_id String                   @db.Uuid
  uploaded_by     String                   @db.Uuid
  original_name   String                   @db.VarChar(255)
  mime_type       String                   @db.VarChar(255)
  size_bytes      Int
  status          DocumentProcessingStatus @default(QUEUED)
  created_at      DateTime                 @default(now()) @db.Timestamptz(6)
  organization    Organization             @relation(fields: [organization_id], references: [organization_id], onDelete: Cascade)
  uploader        User                     @relation(fields: [uploaded_by], references: [user_id], onDelete: Cascade)

  @@index([organization_id])
  @@index([uploaded_by])
  @@map("auth_documents")
}
