{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "db:generate"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "dev": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "NODE_ENV",
        "PORT",
        "DATABASE_URL",
        "CORS_ORIGIN",
        "JWT_ACCESS_SECRET",
        "JWT_REFRESH_SECRET",
        "REDIS_HOST",
        "REDIS_PORT",
        "REDIS_PASSWORD",
        "REDIS_KEY_PREFIX",
        "DOCUMENT_UPLOAD_DIR",
        "MAX_UPLOAD_BYTES"
      ]
    },
    "check": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": []
    },
    "db:generate": {
      "cache": false
    }
  }
}
