{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "db:generate"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "dev": {
      "dependsOn": ["db:generate"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "NODE_ENV",
        "PORT",
        "DATABASE_URL"
      ]
    },
    "check": {
      "dependsOn": ["db:generate"],
      "outputs": []
    },
    "db:generate": {
      "cache": false
    }
  }
}
