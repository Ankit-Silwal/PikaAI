# Backend (local development)
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
AUTH_ACTIVITY_TTL_SECONDS=86400

# npm run setup generates JWT_SECRET and REDIS_PASSWORD locally.
REDIS_HOST=localhost
REDIS_PORT=56379
REDIS_PASSWORD=

# Local PostgreSQL. Compose uses the same credentials inside its network.
# Port 55432 avoids the PostgreSQL instance already using port 5432.
PGHOST=localhost
PGPORT=55432
PGUSER=pikaai
PGPASSWORD=pikaai_local_password
PGDATABASE=pikaai
