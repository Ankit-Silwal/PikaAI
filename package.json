{
  "name": "pikaai",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.6.1",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "npm run start --workspace=@pikaai/backend",
    "dev:api": "turbo run dev --filter=@pikaai/backend",
    "worker": "turbo run dev --filter=@pikaai/worker",
    "worker:start": "npm run start --workspace=@pikaai/worker",
    "check": "turbo run check",
    "db:generate": "npm run db:generate --workspace=@pikaai/backend",
    "db:migrate": "npm run db:migrate --workspace=@pikaai/backend",
    "test": "npm run build --workspace=@pikaai/queues && npm run db:generate && npm run test --workspace=@pikaai/backend",
    "infra:up": "docker compose up -d --wait postgres redis qdrant",
    "db:up": "docker compose up -d --wait postgres redis",
    "db:down": "docker compose stop postgres",
    "docker:up": "docker compose up -d --build --wait",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "turbo": "2.11.9"
  }
}
